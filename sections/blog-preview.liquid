<section class="blog-preview-section sa" id="blog-preview">
  <div class="container">
    <div class="section-header sa">
      <h2>{{ section.settings.heading | default: 'Tips &amp; Inspiration' }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- assign blog_handle = section.settings.blog | default: 'nyheter' -%}
    {%- assign preview_blog = blogs[blog_handle] -%}

    {%- if preview_blog != blank and preview_blog.articles_count > 0 -%}
      <div class="blog-preview-grid">
        {%- for article in preview_blog.articles limit: section.settings.articles_to_show -%}
          <article class="blog-preview-card sa sa-d{{ forloop.index }}">
            <a href="{{ article.url }}" class="blog-preview-card__image-link">
              {%- if article.image != blank -%}
                <img
                  src="{{ article.image | image_url: width: 600, height: 400, crop: 'center' }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="600"
                  height="400"
                  loading="lazy"
                >
              {%- else -%}
                <div class="blog-preview-card__placeholder">
                  <span>📦</span>
                </div>
              {%- endif -%}
            </a>

            <div class="blog-preview-card__content">
              <div class="blog-preview-card__meta">
                <span class="blog-preview-card__date">
                  {{ article.published_at | date: '%d %b %Y' }}
                </span>
                {%- if article.tags.size > 0 -%}
                  <span class="blog-preview-card__tag">{{ article.tags.first }}</span>
                {%- endif -%}
              </div>

              <h3 class="blog-preview-card__title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>

              <p class="blog-preview-card__excerpt">
                {{ article.excerpt_or_content | strip_html | truncate: 110 }}
              </p>

              <a href="{{ article.url }}" class="blog-preview-card__link">
                Läs mer &rarr;
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="blog-preview-cta">
          <a href="{{ preview_blog.url }}" class="btn btn--secondary">Fler tips &amp; inspiration &rarr;</a>
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%}
        Fallback static cards when no blog exists yet.
        These show suggested article topics as placeholders.
      {%- endcomment -%}
      <div class="blog-preview-grid">
        <article class="blog-preview-card blog-preview-card--static sa sa-d1">
          <div class="blog-preview-card__image-link">
            <div class="blog-preview-card__placeholder blog-preview-card__placeholder--1">
              <span>🛁</span>
            </div>
          </div>
          <div class="blog-preview-card__content">
            <div class="blog-preview-card__meta">
              <span class="blog-preview-card__tag">Badrum</span>
            </div>
            <h3 class="blog-preview-card__title">10 smarta tips för ett organiserat badrum</h3>
            <p class="blog-preview-card__excerpt">Gör badrummet till en fridfull oas med smarta förvaringstips som fungerar för alla storlekar.</p>
            <a href="{{ preview_blog.url | default: '/blogs/nyheter' }}" class="blog-preview-card__link">Läs mer &rarr;</a>
          </div>
        </article>

        <article class="blog-preview-card blog-preview-card--static sa sa-d2">
          <div class="blog-preview-card__image-link">
            <div class="blog-preview-card__placeholder blog-preview-card__placeholder--2">
              <span>🍳</span>
            </div>
          </div>
          <div class="blog-preview-card__content">
            <div class="blog-preview-card__meta">
              <span class="blog-preview-card__tag">Kök</span>
            </div>
            <h3 class="blog-preview-card__title">Så organiserar du ditt kök på 30 minuter</h3>
            <p class="blog-preview-card__excerpt">Enkla knep som gör underverk – utan att det kostar skjortan. Ditt kök blir aldrig snyggare!</p>
            <a href="{{ preview_blog.url | default: '/blogs/nyheter' }}" class="blog-preview-card__link">Läs mer &rarr;</a>
          </div>
        </article>

        <article class="blog-preview-card blog-preview-card--static sa sa-d3">
          <div class="blog-preview-card__image-link">
            <div class="blog-preview-card__placeholder blog-preview-card__placeholder--3">
              <span>👗</span>
            </div>
          </div>
          <div class="blog-preview-card__content">
            <div class="blog-preview-card__meta">
              <span class="blog-preview-card__tag">Garderob</span>
            </div>
            <h3 class="blog-preview-card__title">Garderobsorganisation — guide för 2025</h3>
            <p class="blog-preview-card__excerpt">Hitta plagget du letar efter på under 10 sekunder med dessa beprövade garderobstips.</p>
            <a href="{{ preview_blog.url | default: '/blogs/nyheter' }}" class="blog-preview-card__link">Läs mer &rarr;</a>
          </div>
        </article>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
.blog-preview-section {
  padding: 4rem 0;
  background: #F5EFE6;
}

.blog-preview-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 2rem;
  margin-top: 2.5rem;
}

.blog-preview-card {
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,0.07);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  display: flex;
  flex-direction: column;
}

.blog-preview-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(196,112,79,0.12);
}

.blog-preview-card__image-link {
  display: block;
  overflow: hidden;
}

.blog-preview-card__image-link img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.blog-preview-card:hover .blog-preview-card__image-link img {
  transform: scale(1.04);
}

.blog-preview-card__placeholder {
  width: 100%;
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 4rem;
}

.blog-preview-card__placeholder--1 { background: #e8f4f8; }
.blog-preview-card__placeholder--2 { background: #fff8e1; }
.blog-preview-card__placeholder--3 { background: #fce4ec; }

.blog-preview-card__content {
  padding: 1.5rem;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.blog-preview-card__meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}

.blog-preview-card__date {
  font-size: 0.82rem;
  color: #999;
}

.blog-preview-card__tag {
  font-size: 0.78rem;
  font-weight: 700;
  background: #C4704F;
  color: #fff;
  border-radius: 20px;
  padding: 0.1rem 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.blog-preview-card__title {
  font-size: 1.1rem;
  line-height: 1.4;
  margin-bottom: 0.75rem;
  flex: 1;
}

.blog-preview-card__title a {
  text-decoration: none;
  color: #2C2C2C;
  transition: color 0.2s;
}

.blog-preview-card__title a:hover { color: #C4704F; }
.blog-preview-card--static .blog-preview-card__title { color: #2C2C2C; }

.blog-preview-card__excerpt {
  color: #666;
  font-size: 0.9rem;
  line-height: 1.55;
  margin-bottom: 1.25rem;
}

.blog-preview-card__link {
  display: inline-block;
  color: #C4704F;
  font-weight: 700;
  font-size: 0.9rem;
  text-decoration: none;
  transition: color 0.2s;
}

.blog-preview-card__link:hover { color: #a55a3a; }

.blog-preview-cta {
  text-align: center;
  margin-top: 2.5rem;
}

@media (max-width: 768px) {
  .blog-preview-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Tips & Inspiration",
  "tag": "section",
  "class": "section-blog-preview",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Tips & Inspiration"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underrubrik",
      "default": "Smarta idéer för ett organiserat hem"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Välj blogg"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Antal artiklar att visa",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Visa länk till alla artiklar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Tips & Inspiration"
    }
  ]
}
{% endschema %}
