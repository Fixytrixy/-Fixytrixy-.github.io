<section class="blog-section" id="blog">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header sa">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="blog-grid">
      {%- if section.settings.blog != blank -%}
        {%- assign blog_obj = blogs[section.settings.blog] -%}
        {%- for article in blog_obj.articles limit: section.settings.articles_to_show -%}
          <article class="blog-card sa sa-d{{ forloop.index }}">
            {%- if article.image != blank -%}
              <a href="{{ article.url }}" class="blog-card__image">
                <img
                  src="{{ article.image | image_url: width: 600, height: 400, crop: 'center' }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="600"
                  height="400"
                  loading="lazy"
                >
              </a>
            {%- endif -%}
            <div class="blog-card__content">
              <time class="blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: '%d %B %Y' }}
              </time>
              <h3 class="blog-card__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              <a href="{{ article.url }}" class="blog-card__link">Läs mer →</a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="blog-card sa sa-d{{ i }}">
            <div class="blog-card__placeholder-image"></div>
            <div class="blog-card__content">
              <time class="blog-card__date">Tips &amp; Inspiration</time>
              <h3 class="blog-card__title">
                {%- case i -%}
                  {%- when 1 -%}<a href="/blogs/tips">10 smarta tips för ett organiserat badrum</a>
                  {%- when 2 -%}<a href="/blogs/tips">Så organiserar du ditt kök på 30 minuter</a>
                  {%- when 3 -%}<a href="/blogs/tips">Garderobsorganisation — guide för 2025</a>
                {%- endcase -%}
              </h3>
              <p class="blog-card__excerpt">Upptäck våra bästa tips för att skapa ordning och reda i ditt hem.</p>
              <a href="/blogs/tips" class="blog-card__link">Läs mer →</a>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="section-cta sa">
        <a href="{{ section.settings.cta_url | default: '/blogs/tips' }}" class="btn btn--secondary">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.blog-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.blog-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.12);
}

.blog-card__image img,
.blog-card__placeholder-image {
  width: 100%;
  height: 200px;
  object-fit: cover;
  display: block;
}

.blog-card__placeholder-image {
  background: linear-gradient(135deg, #f5efe6, #e8dfd0);
}

.blog-card__content {
  padding: 1.25rem;
}

.blog-card__date {
  font-size: 0.8rem;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.blog-card__title {
  font-size: 1.1rem;
  margin: 0.5rem 0;
  line-height: 1.4;
}

.blog-card__title a {
  text-decoration: none;
  color: #333;
  transition: color 0.3s;
}

.blog-card__title a:hover {
  color: #C4704F;
}

.blog-card__excerpt {
  font-size: 0.9rem;
  color: #666;
  line-height: 1.5;
  margin-bottom: 0.75rem;
}

.blog-card__link {
  font-size: 0.9rem;
  font-weight: 600;
  color: #C4704F;
  text-decoration: none;
  transition: color 0.3s;
}

.blog-card__link:hover {
  color: #b5623f;
}

@media (max-width: 768px) {
  .blog-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Blogg & Tips",
  "tag": "section",
  "class": "section-blog-posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Tips & Inspiration"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underrubrik",
      "default": "Läs våra bästa tips för ett organiserat hem"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blogg"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Antal artiklar att visa",
      "default": 3
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Knapptext",
      "default": "Visa alla tips"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Knapp-URL"
    }
  ],
  "presets": [
    {
      "name": "Blogg & Tips"
    }
  ]
}
{% endschema %}
