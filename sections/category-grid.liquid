<section class="category-grid-section" id="category-grid">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header sa">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection_handle] -%}
        <a
          href="{{ block.settings.collection_url | default: col.url | default: '#' }}"
          class="category-card sa sa-d{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          <div class="category-card__image">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: block.settings.label }}"
                width="600"
                loading="lazy"
              >
            {%- elsif col != blank and col.image != blank -%}
              <img
                src="{{ col.image | image_url: width: 600 }}"
                alt="{{ col.title }}"
                width="600"
                loading="lazy"
              >
            {%- else -%}
              <div class="category-card__placeholder">
                <span class="category-card__icon">{{ block.settings.emoji | default: '🏠' }}</span>
              </div>
            {%- endif -%}
            <div class="category-card__overlay"></div>
          </div>
          <div class="category-card__info">
            <h3>{{ block.settings.label | default: col.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description }}</p>
            {%- elsif col != blank -%}
              <span class="category-card__count">{{ col.products_count }} produkter</span>
            {%- endif -%}
            <span class="category-card__cta">Utforska →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorigrid",
  "tag": "section",
  "class": "section-category-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Organisera varje rum"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underrubrik",
      "default": "Välj ditt rum och hitta de perfekta förvaringslösningarna"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategori",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Rubriklabel",
          "default": "Badrum"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji (visas om ingen bild)",
          "default": "🚿"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Kort beskrivning",
          "default": ""
        },
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Kollektion-handle",
          "default": "badrum"
        },
        {
          "type": "url",
          "id": "collection_url",
          "label": "Länk (åsidosätter kollektion-URL)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Kategoribild"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorigrid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "label": "Badrum",
            "emoji": "🚿",
            "description": "Smarta lösningar för badrummet",
            "collection_handle": "badrum",
            "collection_url": "/collections/badrum"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "Kök",
            "emoji": "🍳",
            "description": "Organisera ditt kök",
            "collection_handle": "kok",
            "collection_url": "/collections/kok"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "Sovrum",
            "emoji": "🛏",
            "description": "Förvaring för sovrummet",
            "collection_handle": "sovrum",
            "collection_url": "/collections/sovrum"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "Garderob",
            "emoji": "👗",
            "description": "Maximera garderobsutrymmet",
            "collection_handle": "garderob",
            "collection_url": "/collections/garderob"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "Hall",
            "emoji": "🚪",
            "description": "Ordning i hallen",
            "collection_handle": "hall",
            "collection_url": "/collections/hall"
          }
        }
      ]
    }
  ]
}
{% endschema %}
