{%- comment -%}
  checkout-trust-badges.liquid
  Renders a set of trust badges suitable for the cart and checkout pages.
  Displays reassurance signals: secure payment, free shipping threshold,
  returns policy, customer rating, and fast delivery.

  Usage: {% render 'checkout-trust-badges' %}
{%- endcomment -%}

<div class="checkout-trust-badges" aria-label="Trygghet och garanti">
  <ul class="checkout-trust-badges__list" role="list">

    <li class="checkout-trust-badge">
      <span class="checkout-trust-badge__icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             focusable="false" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </span>
      <div class="checkout-trust-badge__body">
        <strong>SSL-krypterad betalning</strong>
        <span>Dina kortuppgifter är alltid säkra</span>
      </div>
    </li>

    <li class="checkout-trust-badge">
      <span class="checkout-trust-badge__icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             focusable="false" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13" rx="1"></rect>
          <path d="M16 8h4l3 5v3h-7V8z"></path>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </span>
      <div class="checkout-trust-badge__body">
        <strong>Fri frakt över 499 kr</strong>
        <span>Leverans inom 1–3 arbetsdagar</span>
      </div>
    </li>

    <li class="checkout-trust-badge">
      <span class="checkout-trust-badge__icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             focusable="false" aria-hidden="true">
          <polyline points="1 4 1 10 7 10"></polyline>
          <path d="M3.51 15a9 9 0 1 0 .49-5.34L1 10"></path>
        </svg>
      </span>
      <div class="checkout-trust-badge__body">
        <strong>30 dagars öppet köp</strong>
        <span>Enkel retur – inga frågor ställs</span>
      </div>
    </li>

    <li class="checkout-trust-badge">
      <span class="checkout-trust-badge__icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
             focusable="false" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14
                   2 9.27l6.91-1.01L12 2z"/>
        </svg>
      </span>
      <div class="checkout-trust-badge__body">
        <strong>4,8 / 5 i kundbetyg</strong>
        <span>Baserat på verifierade recensioner</span>
      </div>
    </li>

    <li class="checkout-trust-badge">
      <span class="checkout-trust-badge__icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             focusable="false" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </span>
      <div class="checkout-trust-badge__body">
        <strong>Snabb leverans</strong>
        <span>Beställ innan 14:00 – skickas idag</span>
      </div>
    </li>

  </ul>
</div>

<style>
/* ── Checkout trust badges ──────────────────────────────── */
.checkout-trust-badges {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid #eee;
}

.checkout-trust-badges__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
}

.checkout-trust-badge {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.checkout-trust-badge__icon {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  color: {{ settings.color_primary | default: '#FF6B35' }};
  margin-top: 0.1rem;
}

.checkout-trust-badge__body {
  display: flex;
  flex-direction: column;
  font-size: 0.875rem;
  line-height: 1.4;
}

.checkout-trust-badge__body strong {
  color: #333;
  font-weight: 600;
}

.checkout-trust-badge__body span {
  color: #777;
}

@media (max-width: 768px) {
  .checkout-trust-badges__list {
    gap: 0.75rem;
  }
}
</style>
