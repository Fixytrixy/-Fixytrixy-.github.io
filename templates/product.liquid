<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "{{ product.title | escape }}",
  "image": "{{ product.featured_image | image_url: width: 800 }}",
  "description": "{{ product.description | escape | strip_html | truncatewords: 30 }}",
  "sku": "{{ product.selected_variant.sku }}",
  "offers": {
    "@type": "Offer",
    "price": "{{ product.price | money_without_currency | strip_html | remove: ',' }}",
    "priceCurrency": "SEK",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": "{{ shop.url }}{{ product.url }}"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "{{ product.reviews_count | default: 0 }}"
  }
}
</script>

<div class="product-page">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/">
            <span itemprop="name">Hem</span>
          </a>
          <meta itemprop="position" content="1">
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="{{ product.collections.first.url }}">
            <span itemprop="name">{{ product.collections.first.title | escape }}</span>
          </a>
          <meta itemprop="position" content="2">
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{{ product.title | escape }}</span>
          <meta itemprop="position" content="3">
        </li>
      </ol>
    </nav>
    <div class="product-layout">
      <div class="product-images">
        <img src="{{ product.featured_image | image_url: width: 600, height: 600, crop: 'center' }}" alt="{{ product.title }}" width="600" height="600">
        {%- for image in product.images -%}
          <img src="{{ image | image_url: width: 600, height: 600, crop: 'center' }}" alt="{{ product.title }}" width="600" height="600">
        {%- endfor -%}
      </div>

      <div class="product-info">
        <h1>{{ product.title }}</h1>
        <div class="price">{{ product.price | money }}</div>

        <div class="product-description">
          {{ product.description }}
        </div>

        {%- assign current_variant = product.selected_or_first_available_variant -%}
        {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= 5 and current_variant.inventory_quantity > 0 -%}
          <div class="low-stock-warning">
            ⚡ Endast {{ current_variant.inventory_quantity }} kvar i lager!
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_add_url }}" method="post" class="product-form" id="product-form">
          <select name="id" id="variant-select">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == product.selected_variant %}selected{% endif %}>
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>

          <div class="quantity">
            <label for="quantity">Antal:</label>
            <input type="number" name="quantity" id="quantity" value="1" min="1">
          </div>

          <button type="submit" class="add-to-cart-btn">Lägg i kundvagn</button>
        </form>

        <div class="product-trust-badges">
          <div class="trust-badge">
            <span class="trust-badge__icon">🚚</span>
            <span>Fri frakt över 499 kr</span>
          </div>
          <div class="trust-badge">
            <span class="trust-badge__icon">🔄</span>
            <span>30 dagars öppet köp</span>
          </div>
          <div class="trust-badge">
            <span class="trust-badge__icon">🔒</span>
            <span>Säker betalning</span>
          </div>
          <div class="trust-badge">
            <span class="trust-badge__icon">⭐</span>
            <span>Över 500 nöjda kunder</span>
          </div>
        </div>

        <div class="product-meta">
          <p><strong>Leveranstid:</strong> 1-3 arbetsdagar</p>
          <p><strong>Retur:</strong> 30 dagar öppet köp</p>
          <p><strong>Frakt:</strong> Fri frakt över 499 SEK</p>
        </div>
      </div>
    </div>

    <div class="product-reviews">
      <h2>Kundrecensioner</h2>
      {%- if product.metafields.reviews -%}
        {{ product.metafields.reviews }}
      {%- else -%}
        <p>Inga recensioner än. Bli den första att recensera denna produkt!</p>
      {%- endif -%}
    </div>

    <div class="related-products">
      <h2>Köps ofta tillsammans</h2>
      <div class="products-grid">
        {%- for related_product in product.collections.first.products limit: 4 -%}
          {%- if related_product != product -%}
            <div class="product-card">
              <a href="{{ related_product.url }}">
                <img src="{{ related_product.featured_image | image_url: width: 300, height: 300, crop: 'center' }}" alt="{{ related_product.title | escape }}" width="300" height="300">
              </a>
              <h4><a href="{{ related_product.url }}">{{ related_product.title }}</a></h4>
              <span class="price">{{ related_product.price | money }}</span>
              <form action="{{ routes.cart_add_url }}" method="post" class="quick-add-inline">
                <input type="hidden" name="id" value="{{ related_product.variants.first.id }}">
                <button type="submit" class="btn btn--primary btn--sm">Lägg till</button>
              </form>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<!-- Sticky mobile buy button -->
<div class="sticky-buy-bar" id="sticky-buy-bar">
  <div class="sticky-buy-bar__inner">
    <div class="sticky-buy-bar__info">
      <span class="sticky-buy-bar__title">{{ product.title | truncate: 30 }}</span>
      <span class="sticky-buy-bar__price">{{ product.price | money }}</span>
    </div>
    <button class="sticky-buy-bar__btn" id="sticky-buy-btn">Lägg i varukorg</button>
  </div>
</div>

<style>
.product-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  margin-bottom: 3rem;
}

.product-images img {
  width: 100%;
  margin-bottom: 1rem;
}

.product-info h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

.price {
  font-size: 2rem;
  font-weight: bold;
  color: {{ settings.color_primary }};
  margin-bottom: 2rem;
}

.product-description {
  margin-bottom: 2rem;
  line-height: 1.6;
}

.product-form {
  margin-bottom: 2rem;
}

.product-form select, .product-form input {
  width: 100%;
  padding: 0.75rem;
  margin-bottom: 1rem;
  border: 1px solid #ddd;
  border-radius: 4px;
}

.quantity {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.add-to-cart-btn {
  background-color: {{ settings.color_primary }};
  color: white;
  border: none;
  padding: 1rem 2rem;
  font-size: 1.1rem;
  border-radius: 4px;
  cursor: pointer;
  width: 100%;
  transition: background-color 0.3s;
}

.add-to-cart-btn:hover {
  background-color: #45a049;
}

.product-meta {
  background-color: #f9f9f9;
  padding: 1.5rem;
  border-radius: 8px;
}

.product-meta p {
  margin-bottom: 0.5rem;
}

.product-reviews, .related-products {
  margin-top: 3rem;
  padding-top: 3rem;
  border-top: 1px solid #eee;
}

.related-products .products-grid {
  margin-top: 2rem;
}

@media (max-width: 768px) {
  .product-layout {
    grid-template-columns: 1fr;
  }
}

/* Low stock warning */
.low-stock-warning {
  background-color: #fff3e6;
  color: #C4704F;
  padding: 0.75rem 1rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.95rem;
  margin-bottom: 1rem;
  animation: pulse-stock 2s ease-in-out infinite;
}

@keyframes pulse-stock {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* Trust badges below buy button */
.product-trust-badges {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  margin-top: 1.5rem;
  margin-bottom: 1.5rem;
}

.trust-badge {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.85rem;
  color: #555;
}

.trust-badge__icon {
  font-size: 1.1rem;
}

/* Quick add inline button */
.quick-add-inline {
  padding: 0.5rem 0;
}

.btn--sm {
  padding: 0.5rem 1rem;
  font-size: 0.85rem;
}

/* Sticky mobile buy bar */
.sticky-buy-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  box-shadow: 0 -2px 12px rgba(0,0,0,0.15);
  z-index: 999;
  padding: 0.75rem 1rem;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.sticky-buy-bar.is-visible {
  transform: translateY(0);
}

.sticky-buy-bar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 600px;
  margin: 0 auto;
}

.sticky-buy-bar__info {
  display: flex;
  flex-direction: column;
}

.sticky-buy-bar__title {
  font-size: 0.85rem;
  font-weight: 600;
  color: #333;
}

.sticky-buy-bar__price {
  font-size: 1rem;
  font-weight: 700;
  color: {{ settings.color_primary }};
}

.sticky-buy-bar__btn {
  background-color: #C4704F;
  color: #fff;
  border: none;
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color 0.3s;
}

.sticky-buy-bar__btn:hover {
  background-color: #b5623f;
}

@media (max-width: 768px) {
  .sticky-buy-bar {
    display: block;
  }
  .product-trust-badges {
    grid-template-columns: 1fr;
  }
}

/* Product card star ratings */
.product-card__rating {
  margin-bottom: 0.25rem;
}

.product-card__rating .stars {
  display: flex;
  gap: 1px;
}

.product-card__rating .star {
  font-size: 0.85rem;
  color: #ddd;
}

.product-card__rating .star.filled {
  color: #FFD700;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  /* Sticky mobile buy bar — shows after scrolling past the main add-to-cart button */
  var stickyBar = document.getElementById('sticky-buy-bar');
  var productForm = document.getElementById('product-form');
  var stickyBtn = document.getElementById('sticky-buy-btn');

  if (stickyBar && productForm) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          stickyBar.classList.remove('is-visible');
        } else {
          stickyBar.classList.add('is-visible');
        }
      });
    }, { threshold: 0 });
    observer.observe(productForm);
  }

  if (stickyBtn && productForm) {
    stickyBtn.addEventListener('click', function() {
      var submitBtn = productForm.querySelector('[type="submit"]');
      if (submitBtn) submitBtn.click();
    });
  }
});
</script>